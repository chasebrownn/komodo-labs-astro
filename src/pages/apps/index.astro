---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const apps = [
  {
    name: 'Pomodoro Timer',
    description: 'A clean focus timer built on the Pomodoro technique. 25 minutes of focused work, 5 minute breaks.',
    href: '/apps/pomodoro',
    tag: 'Productivity',
    image: '/apps/pomodoro.png',
  },
  {
    name: 'JSON Formatter',
    description: 'Paste raw or minified JSON and get it back clean, indented, and syntax highlighted. Runs in your browser.',
    href: '/apps/json-formatter',
    tag: 'Developer',
    image: '/apps/json-formatter.png',
  },
];
---

<Layout
  title="Apps — Komodo Labs"
  description="Small, useful apps built by Komodo Labs. No accounts, no tracking, no backend — just tools that work."
>
<style>
  .page-header {
    padding: 72px 0 56px;
    opacity: 0;
    animation: fadeUp 0.5s ease 0.1s both;
  }

  .section-label {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--gray-500);
    letter-spacing: 2.5px;
    text-transform: uppercase;
    margin-bottom: 14px;
  }

  .page-header h1 {
    font-size: 40px;
    font-weight: 700;
    letter-spacing: -1px;
  }

  .page-header p {
    font-size: 15px;
    color: var(--gray-400);
    font-weight: 300;
    margin-top: 12px;
  }

  .apps {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 24px;
    margin-bottom: 100px;
    opacity: 0;
    animation: fadeUp 0.5s ease 0.2s both;
  }

  .app-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    transition: border-color 0.2s, transform 0.2s;
  }

  .app-card:hover {
    border-color: var(--border-hi);
    transform: translateY(-2px);
  }

  .app-card:hover .app-name { color: var(--neon); }

  .app-image {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    object-position: top;
    display: block;
    border-bottom: 1px solid var(--border);
  }

  .app-body {
    padding: 20px 22px 22px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
  }

  .app-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .app-name {
    font-size: 16px;
    font-weight: 600;
    color: var(--white);
    transition: color 0.2s;
  }

  .app-tag {
    font-family: var(--font-mono);
    font-size: 10px;
    padding: 4px 9px;
    border-radius: 5px;
    background: var(--bg);
    color: var(--gray-400);
    border: 1px solid var(--border);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .app-desc {
    font-size: 13.5px;
    color: var(--gray-400);
    font-weight: 300;
    line-height: 1.6;
  }
</style>

<div class="wrapper">

  <Nav />

  <div class="page-header">
    <div class="section-label">Tools</div>
    <h1>Apps</h1>
    <p>Small, useful tools. No accounts, no tracking, no backend.</p>
  </div>

  <div class="apps">
    {apps.map((app) => (
      <a href={app.href} class="app-card">
        <img src={app.image} alt={app.name} class="app-image" />
        <div class="app-body">
          <div class="app-header">
            <div class="app-name">{app.name}</div>
            <span class="app-tag">{app.tag}</span>
          </div>
          <div class="app-desc">{app.description}</div>
        </div>
      </a>
    ))}
  </div>

  <Footer />

</div>

</Layout>
